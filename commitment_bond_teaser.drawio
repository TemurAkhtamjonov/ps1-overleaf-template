<mxCell id="title" value="FROM CHEAP TALK TO CALIBRATED TRUST" style="text;html=1;align=center;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#15395D;" vertex="1" parent="1"><mxGeometry x="250" y="5" width="700" height="25" as="geometry"/></mxCell>
<mxCell id="subtitle" value="A transparent commitment bond changes the cost of breaking an AI promise." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#4B6F91;" vertex="1" parent="1"><mxGeometry x="250" y="29" width="700" height="22" as="geometry"/></mxCell>
<mxCell id="problem" value="&lt;b&gt;PROBLEM&lt;/b&gt;&lt;br&gt;Cheap talk: a promise does not&lt;br&gt;change the payoff from breaking it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#82ADD7;fontColor=#15395D;fontSize=14;spacingLeft=16;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="245" height="94" as="geometry"/></mxCell>
<mxCell id="participant" value="&lt;b&gt;PARTICIPANT&lt;/b&gt;&lt;br&gt;1. Forecast compliance&lt;br&gt;2. Invest s from 10 points" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFC;strokeColor=#82ADD7;fontColor=#15395D;fontSize=14;spacingLeft=16;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="310" y="70" width="245" height="94" as="geometry"/></mxCell>
<mxCell id="ai" value="&lt;b&gt;AI RECEIVER + BOND&lt;/b&gt;&lt;br&gt;Receives 3s; promises 3s/2.&lt;br&gt;A violation transfers 2s&lt;br&gt;to the participant." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5E9;strokeColor=#EE8A22;fontColor=#15395D;fontSize=14;spacingLeft=16;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="600" y="60" width="285" height="114" as="geometry"/></mxCell>
